{
  "realm": "gymflow",
  "enabled": true,
  "displayName": "GymFlow Local",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "GYM_ADMIN", "description": "Administra academias vinculadas" },
      { "name": "STUDENT", "description": "Consulta catálogo e gerencia os próprios treinos" }
    ]
  },
  "clients": [
    {
      "clientId": "gymflow-web",
      "name": "GymFlow Web Local",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "protocol": "openid-connect",
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        { "name": "gym-service-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false, "config": { "included.client.audience": "gym-service", "access.token.claim": "true" } },
        { "name": "workout-service-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false, "config": { "included.client.audience": "workout-service", "access.token.claim": "true" } },
        { "name": "assistant-service-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false, "config": { "included.client.audience": "assistant-service", "access.token.claim": "true" } }
      ]
    },
    { "clientId": "gym-service", "enabled": true, "bearerOnly": true, "protocol": "openid-connect" },
    { "clientId": "workout-service", "enabled": true, "bearerOnly": true, "protocol": "openid-connect" },
    { "clientId": "assistant-service", "enabled": true, "bearerOnly": true, "protocol": "openid-connect" }
  ],
  "users": [
    {
      "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaa1",
      "username": "admin.aurora",
      "firstName": "Admin",
      "lastName": "Aurora",
      "email": "admin.aurora@example.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "gymflow-admin-a", "temporary": false }],
      "realmRoles": ["GYM_ADMIN"]
    },
    {
      "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaa2",
      "username": "admin.movimento",
      "firstName": "Admin",
      "lastName": "Movimento",
      "email": "admin.movimento@example.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "gymflow-admin-b", "temporary": false }],
      "realmRoles": ["GYM_ADMIN"]
    },
    {
      "id": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbb1",
      "username": "aluna.demo",
      "firstName": "Aluna",
      "lastName": "Demo",
      "email": "aluna.demo@example.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "gymflow-student-a", "temporary": false }],
      "realmRoles": ["STUDENT"]
    },
    {
      "id": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbb2",
      "username": "aluno.demo",
      "firstName": "Aluno",
      "lastName": "Demo",
      "email": "aluno.demo@example.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "gymflow-student-b", "temporary": false }],
      "realmRoles": ["STUDENT"]
    }
  ]
}
