# Copie para .env e substitua todos os valores change-me. Use apenas localmente.
POSTGRES_SUPERUSER_PASSWORD=change-me-local-superuser
GYM_DB_PASSWORD=change-me-local-gym
WORKOUT_DB_PASSWORD=change-me-local-workout
ASSISTANT_DB_PASSWORD=change-me-local-assistant
KEYCLOAK_DB_PASSWORD=change-me-local-keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-keycloak-admin
RABBITMQ_USER=gymflow
RABBITMQ_PASSWORD=change-me-local-rabbitmq
RABBITMQ_VHOST=gymflow

# O modo demo é determinístico e não usa rede. Para Gemini, troque o provider e configure a chave apenas no .env local.
AI_PROVIDER=demo
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
AI_MAX_OUTPUT_TOKENS=2048

